## mozconfig for compiling Nocturne Browser for macOS (Apple Silicon) natively

# aarch64 build
ac_add_options --target=aarch64

# Please do not redistribute this build with official branding if you are not part of the project.
#ac_add_options --enable-official-branding
# For ESR enable the below and disable the above
ac_add_options --with-branding=browser/branding/esr
# For potential nightly experimentation enable the below and disable the above.
#ac_add_options --with-branding=browser/branding/nightly

# Updater stuffs
ac_add_options --disable-updater
# Enable if update server and signatures are figured out
#ac_add_options --enable-nss-mar
ac_add_options --with-ccache=sccache

# 16 jobs for 16 cores
mk_add_options MOZ_MAKE_FLAGS="-j4"

# Build only Nocturne
ac_add_options --enable-application=browser
ac_add_options --disable-artifact-builds
export MOZ_INCLUDE_SOURCE_INFO=1
export MOZ_SOURCE_CHANGESET=iloveneedingtobodgechangesetfornoreason

# Optimization settings
ac_add_options --disable-debug
ac_add_options --disable-debug-js-modules
ac_add_options --disable-debug-symbols
ac_add_options --disable-tests
ac_add_options --enable-clang-plugin
ac_add_options --enable-hardening
ac_add_options --enable-install-strip
ac_add_options --enable-jemalloc
ac_add_options --enable-lto
ac_add_options --enable-optimize="-O2"
ac_add_options --enable-release
ac_add_options --enable-rust-simd
ac_add_options --enable-replace-malloc
ac_add_options --enable-strip
MOZ_OPTIMIZE=1
export MOZ_OPTIMIZE=1
mk_add_options MOZ_OPTIMIZE=1
export MOZILLA_OFFICIAL=1
export STRIP_FLAGS="--strip-debug --strip-unneeded"
mk_add_options "export JAR_COMPRESSION=brotli"

# Media settings
ac_add_options --disable-eme
ac_add_options --enable-av1
ac_add_options --enable-jxl
ac_add_options --enable-raw
ac_add_options --enable-webrtc

# Add-ons
ac_add_options --allow-addon-sideload
ac_add_options --with-unsigned-addon-scopes=app,system

# Client settings
ac_add_options --disable-backgroundtasks
ac_add_options --disable-crashreporter
ac_add_options --disable-default-browser-agent

ac_add_options --without-wasm-sandboxed-libraries
mk_add_options MOZ_CRASHREPORTER=0
mk_add_options MOZ_DATA_REPORTING=0
mk_add_options MOZ_SERVICES_HEALTHREPORT=0
mk_add_options MOZ_TELEMETRY_REPORTING=
export MOZ_CRASHREPORTER=0
export MOZ_DATA_REPORTING=0
export MOZ_REQUIRE_SIGNING=
export MOZ_TELEMETRY_REPORTING=
export MOZ_PACKAGE_JSSHELL=1

# Set -Copt-level=3
export OPT_LEVEL="3"
ac_add_options OPT_LEVEL="3"
export RUSTC_OPT_LEVEL="3"
ac_add_options RUSTC_OPT_LEVEL="3"

# Enable LTO
export MOZ_LTO=1
ac_add_options MOZ_LTO=1
export MOZ_PGO=1
ac_add_options MOZ_PGO=1

# Compiler, Linker, and Rust flags
export CFLAGS="-O2"
export CPPFLAGS="-O2"
export CXXFLAGS="-O2"
export LDFLAGS="-Wl,-O2"
export POLLY="-mllvm -polly -mllvm -polly-2nd-level-tiling -mllvm -polly-loopfusion-greedy -mllvm -polly-pattern-matching-based-opts -mllvm -polly-position=before-vectorizer -mllvm -polly-vectorizer=stripmine"
export RUSTFLAGS="-C target-cpu=apple-m1 -C codegen-units=1 -C opt-level=3"
export VERBOSE=1
